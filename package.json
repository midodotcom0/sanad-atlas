{
  "name": "sanad-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "dev:web": "next dev",
    "dev:api": "node --experimental-sqlite worker/dev-server.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:backend": "PYTHONPATH=backend python3 -m unittest discover -s backend/tests -v",
    "test:watch": "vitest",
    "import:test": "node scripts/validate-test-import.mjs",
    "import:turath": "node scripts/import-turath-corpus.mjs --fetch",
    "import:shamela": "node scripts/import-shamela-rijal.mjs",
    "atlas:build": "node --experimental-sqlite scripts/build-atlas-db.mjs",
    "atlas:release": "node worker/tools/atlas-release.mjs",
    "atlas:audit": "node worker/tools/query-plan-audit.mjs",
    "atlas:rollback:dryrun": "node worker/tools/release-dryrun.mjs",
    "test:atlas": "node --experimental-sqlite --test tests/atlas-db-schema-translate.check.mjs tests/atlas-db-id-scheme.check.mjs tests/atlas-db-normalize-parity.check.mjs tests/atlas-db-build.check.mjs tests/atlas-identity-lifecycle.check.mjs tests/shamela-rijal.check.mjs",
    "test:rijal-statements": "node --test tests/rijal-statements.check.mjs",
    "test:editorial": "node --experimental-sqlite --test tests/editorial-api.check.mjs",
    "test:gold:audit": "node data/gold/check-gold.mjs",
    "test:gold:strict": "node data/gold/check-gold.mjs --strict",
    "test:worker": "node --experimental-sqlite --test tests/worker-contract.check.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.2.8",
    "cytoscape": "^3.33.1",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.32.0",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3"
  }
}
